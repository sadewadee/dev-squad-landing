---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'dev-squad — eleven agents, nine PDCA phases, one PR worth shipping.',
  description = 'A multi-agent orchestration plugin for Claude Code. Eleven specialist agents run a nine-phase PDCA workflow with hard quality gates: anti-AI-slop design, runtime QA, stability auditing.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter Tight + Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;700;800&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Motion bundle: word stagger, scroll reveals, header state, stat
         counters, hero parallax, hero cursor tilt. Honors
         prefers-reduced-motion (no-ops gracefully). -->
    <script>
      import '../scripts/motion.ts';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
