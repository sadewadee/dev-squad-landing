---
// Header — sticky navigation
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Logo -->
    <a href="#top" class="logo" aria-label="dev-squad home">
      <span class="logo-mark" aria-hidden="true">◆</span>
      <span class="logo-name">dev-squad</span>
      <span class="logo-sub">Build Nº 9 <span class="logo-sep">·</span> Berlin / Open / Earth</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="#agents" class="nav-link">
        Agents<sup class="nav-count">11</sup>
      </a>
      <a href="#method" class="nav-link">
        Phases<sup class="nav-count">09</sup>
      </a>
      <a href="#labs" class="nav-link">
        Workflows<sup class="nav-count">05</sup>
      </a>
      <a href="https://github.com/sadewadee/dev-squad-plugin#readme" class="nav-link" target="_blank" rel="noopener noreferrer">
        Docs
      </a>
      <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <!-- CTA Buttons -->
    <div class="header-ctas">
      <a
        href="https://github.com/sadewadee/dev-squad-plugin#install"
        class="pill-btn pill-outlined header-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        Install
      </a>
      <a
        href="https://github.com/sadewadee/dev-squad-plugin"
        class="pill-btn pill-filled header-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        Star · 1.2K
      </a>
    </div>

    <!-- Hamburger (mobile) -->
    <button
      class="hamburger"
      id="hamburger-btn"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" role="dialog" aria-label="Navigation menu" aria-modal="true">
  <button class="mobile-close" id="mobile-close-btn" aria-label="Close navigation menu">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <nav aria-label="Mobile navigation">
    <a href="#agents" class="mobile-menu-link">Agents <span style="color: var(--ink-faint); font-size: 1rem;">11</span></a>
    <a href="#method" class="mobile-menu-link">Phases <span style="color: var(--ink-faint); font-size: 1rem;">09</span></a>
    <a href="#labs" class="mobile-menu-link">Workflows <span style="color: var(--ink-faint); font-size: 1rem;">05</span></a>
    <a href="https://github.com/sadewadee/dev-squad-plugin#readme" class="mobile-menu-link" target="_blank" rel="noopener noreferrer">Docs</a>
    <a href="#contact" class="mobile-menu-link">Contact</a>
  </nav>
  <div style="margin-top: auto; display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="https://github.com/sadewadee/dev-squad-plugin#install" class="pill-btn pill-outlined" target="_blank" rel="noopener noreferrer">Install</a>
    <a href="https://github.com/sadewadee/dev-squad-plugin" class="pill-btn pill-filled" target="_blank" rel="noopener noreferrer">Star on GitHub</a>
  </div>
</div>

<script>
  const hamburger = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('mobile-close-btn');

  function openMenu() {
    mobileMenu?.classList.add('open');
    hamburger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close on anchor link click
  mobileMenu?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 36px; /* below topbar */
    background-color: var(--paper);
    border-bottom: 1px solid var(--line);
    z-index: 90;
    padding-block: 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    font-size: 1.25rem;
    font-weight: 800;
    font-family: var(--font-sans);
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .logo-name {
    font-size: 0.875rem;
    font-weight: 700;
    font-family: var(--font-sans);
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .logo-sub {
    font-size: 0.6875rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .logo-sep {
    color: var(--ink-faint);
    margin-inline: 0.2rem;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  .header-ctas {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink);
    padding: 4px;
    margin-left: auto;
  }

  .mobile-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink);
    padding: 4px;
  }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .header-ctas { display: none; }
    .hamburger { display: flex; }
    .logo-sub { display: none; }
  }

  @media (max-width: 480px) {
    .logo-name { display: none; }
  }
</style>
