---
import { Image } from 'astro:assets';
import ctaImg from '../../assets/cta.png';
---

<section id="contact" class="cta-section section-py">
  <div class="cta-bg-wrap" aria-hidden="true">
    <Image
      src={ctaImg}
      alt=""
      class="cta-bg-img"
      widths={[800, 1200, 1600]}
      sizes="100vw"
    />
    <div class="cta-bg-overlay"></div>
  </div>

  <div class="container cta-inner">
    <div class="cta-content">
      <p class="cta-label section-label">VII. Contact / Spawn · One command to ship</p>
      <p class="cta-counter">008 / 008</p>

      <h2 class="cta-h2">
        Spawn the squad. Ship the build.
      </h2>

      <p class="cta-body">
        Install the plugin, run <code>/dev-squad build</code>, and watch eleven agents take it from ULTRAPLAN to SHIP — gated, verified, anti-slop by default.
      </p>

      <div class="cta-buttons">
        <a
          href="https://github.com/dev-squad/dev-squad"
          class="pill-btn pill-filled cta-btn-filled"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          Star on GitHub
        </a>
        <a
          href="https://github.com/dev-squad/dev-squad#readme"
          class="pill-btn pill-light"
          target="_blank"
          rel="noopener noreferrer"
        >
          Read docs
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="cta-status">
        <span class="cta-status-dot" aria-hidden="true">●</span>
        <span>Live v4.9.0 / Apache-2.0</span>
        <span class="cta-status-sep" aria-hidden="true">·</span>
        <span>52.5200° N · 13.4050° E</span>
        <span class="cta-status-sep" aria-hidden="true">·</span>
        <span>Nº 08</span>
        <span class="cta-status-sep" aria-hidden="true">·</span>
        <span>DEV-SQUAD · FIN.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    overflow: hidden;
    background-color: var(--ink);
    color: var(--paper);
  }

  .cta-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
    display: block;
  }

  .cta-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(21,20,15,0.85) 0%, rgba(21,20,15,0.6) 100%);
  }

  .cta-inner {
    position: relative;
    z-index: 1;
  }

  .cta-content {
    max-width: 680px;
  }

  .cta-label {
    color: rgba(239, 231, 210, 0.5);
  }

  .cta-counter {
    font-size: 0.6875rem;
    color: rgba(239, 231, 210, 0.3);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    margin-top: 0.25rem;
    margin-bottom: 2rem;
  }

  .cta-h2 {
    color: var(--paper);
    margin-bottom: 1.25rem;
  }

  .cta-body {
    font-size: 1.0625rem;
    color: rgba(239, 231, 210, 0.75);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .cta-body code {
    background-color: rgba(239, 231, 210, 0.12);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--paper);
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .cta-btn-filled {
    background-color: var(--coral);
    border-color: var(--coral);
    color: var(--paper);
  }

  .cta-btn-filled:hover {
    background-color: var(--coral-soft);
    border-color: var(--coral-soft);
  }

  .cta-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.6875rem;
    color: rgba(239, 231, 210, 0.4);
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }

  .cta-status-dot {
    color: var(--coral);
    font-size: 0.5rem;
  }

  .cta-status-sep {
    color: rgba(239, 231, 210, 0.2);
  }
</style>
